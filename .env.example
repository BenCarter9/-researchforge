# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/researchforge

# Anthropic API key for Claude analysis passes
ANTHROPIC_API_KEY=

# Optional GLM-5.2 desk memo (OpenAI-compatible). First key found wins:
# GLM_API_KEY, else OPENROUTER_API_KEY, else ZAI_API_KEY.
# Without a key the /desk page still shows a labeled cached GLM-5.2 draft plus
# the exact prompt and model id (zai-org/GLM-5.2).
# RESEARCHFORGE_DEV_SEED=1
GLM_API_KEY=
# OPENROUTER_API_KEY=
# ZAI_API_KEY=
# GLM_BASE_URL=
# GLM_REQUEST_MODEL=

# SEC EDGAR requires a descriptive User-Agent with a real contact on every
# request. Set this to your own tool name and email before running against
# EDGAR — SEC may block requests that don't identify a real contact.
SEC_USER_AGENT="ResearchForge you@example.com"
